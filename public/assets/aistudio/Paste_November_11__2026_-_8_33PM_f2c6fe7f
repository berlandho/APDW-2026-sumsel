      renderJudgeSelectorCards();
      checkSavedSession();
    };

    function checkSavedSession() {
      const savedJudgeId = localStorage.getItem('APDW_2026_ACTIVE_JUDGE');
      if (savedJudgeId) {
        selectJudge(parseInt(savedJudgeId));
      } else {
        document.getElementById('judgeSelectorView').classList.remove('hidden');
        document.getElementById('judgingWorkspaceView').classList.add('hidden');
        document.getElementById('judgeInfoBar').classList.add('hidden');
      }
    }

    function renderJudgeSelectorCards() {
      const container = document.getElementById('judgeListCards');
      container.innerHTML = OFFICIAL_JUDGES.map(j => `
        <div onclick="selectJudge(${j.id})" class="p-4 rounded-xl border border-slate-200 hover:border-gold-500 bg-white hover:bg-gold-50/30 transition cursor-pointer flex items-start gap-3.5 group shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-brand-50 group-hover:bg-gold-500 text-brand-700 group-hover:text-white flex items-center justify-center font-bold text-sm transition">
            J${j.id}
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="font-bold text-slate-800 group-hover:text-brand-900 text-sm truncate">${j.name}</h4>
            <p class="text-xs text-slate-500 mt-0.5">${j.role}</p>
          </div>
          <i class="fa-solid fa-chevron-right text-slate-300 group-hover:text-gold-500 transition mt-2"></i>
        </div>
      `).join('');
    }

    function selectJudge(judgeId) {
      currentJudgeId = judgeId;
      const judge = OFFICIAL_JUDGES.find(j => j.id === judgeId);
      
      // Update LocalStorage active judge
      localStorage.setItem('APDW_2026_ACTIVE_JUDGE', judgeId);

      // Load judge specific data
      loadJudgeData(judgeId);

      // UI Update
      document.getElementById('activeJudgeName').innerText = judge.name;
      document.getElementById('activeJudgeInstansi').innerText = judge.role;
      document.getElementById('printJudgeName').innerText = judge.name;
      document.getElementById('printJudgeInstansi').innerText = judge.role;
      document.getElementById('printSignatureName').innerText = judge.name;

      document.getElementById('judgeSelectorView').classList.add('hidden');
      document.getElementById('judgingWorkspaceView').classList.remove('hidden');
      document.getElementById('judgeInfoBar').classList.remove('hidden');
      document.getElementById('judgeInfoBar').classList.add('flex');

      renderScoringCards();
      updateProgressAndRecap();
    }

    function switchJudge() {
      if(confirm('Apakah Anda ingin berganti dewan juri? Data Anda tersimpan secara otomatis.')) {
        localStorage.removeItem('APDW_2026_ACTIVE_JUDGE');
        currentJudgeId = null;
        document.getElementById('judgeSelectorView').classList.remove('hidden');
        document.getElementById('judgingWorkspaceView').classList.add('hidden');
        document.getElementById('judgeInfoBar').classList.add('hidden');
      }
    }

    function getStorageKey(judgeId) {
      return `APDW_2026_SCORES_JUDGE_${judgeId}`;
    }

    function loadJudgeData(judgeId) {
      const raw = localStorage.getItem(getStorageKey(judgeId));
      if (raw) {
        try {
          judgeScores = JSON.parse(raw);
        } catch(e) {
          judgeScores = {};
        }
      } else {
        judgeScores = {};
      }
    }

    function saveJudgeData() {
      if (currentJudgeId) {
        localStorage.setItem(getStorageKey(currentJudgeId), JSON.stringify(judgeScores));
        updateProgressAndRecap();
      }
    }

    function calculateTotalScore(scores) {
      if (!scores) return 0;
      const c = (parseFloat(scores.cerita) || 0) * WEIGHTS.cerita;
      const b = (parseFloat(scores.budaya) || 0) * WEIGHTS.budaya;
      const p = (parseFloat(scores.potensi) || 0) * WEIGHTS.potensi;
      const v = (parseFloat(scores.visual) || 0) * WEIGHTS.visual;
      const a = (parseFloat(scores.audio) || 0) * WEIGHTS.audio;
      const e = (parseFloat(scores.editing) || 0) * WEIGHTS.editing;
      const pr = (parseFloat(scores.promosi) || 0) * WEIGHTS.promosi;
      return (c + b + p + v + a + e + pr).toFixed(2);
    }

    function isVideoCompleted(vId) {
      const s = judgeScores[vId];
      if (!s) return false;
      return (
        s.cerita !== undefined && s.cerita !== '' &&
        s.budaya !== undefined && s.budaya !== '' &&
        s.potensi !== undefined && s.potensi !== '' &&
        s.visual !== undefined && s.visual !== '' &&
        s.audio !== undefined && s.audio !== '' &&
        s.editing !== undefined && s.editing !== '' &&
        s.promosi !== undefined && s.promosi !== ''
      );
    }

